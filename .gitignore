# Rust build output
/target/

# Local Python environments and bytecode
/.venv*/
__pycache__/
*.py[cod]

# Machine-specific editor settings
/.vscode/

# Local previews, validation output, backups, and screenshots
# Keep local outputs under data alongside the bundled map assets.
/data/*
!/data/engomi/
/data/engomi/*.png
/data/engomi/*.ppm
/Screenshot From *.png

# Large generated map geometry; rebuild with the map import/bake tools
/data/engomi/streets.txt
/data/engomi/scene.pack

# Optional local imagery; redistribution rights are not established
/data/engomi/aerial/
